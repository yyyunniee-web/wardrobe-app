# 大陆访问默认：同源反代（勿填则用 /api 与 /media）
# VITE_API_BASE=/api
# VITE_IMG_PUBLIC_BASE=/media

# 若已为 Worker / R2 绑定自定义域名，可改为直连：
# VITE_API_BASE=https://api.yourdomain.com
# VITE_IMG_PUBLIC_BASE=https://img.yourdomain.com

# 反代目标（一般不用改）
# VITE_WORKER_ORIGIN=https://wardrobe-api.yyyunniee.workers.dev
# VITE_R2_PUBLIC_HOST=pub-ab5fbb0dc5a94486aad97da609e95b55.r2.dev
