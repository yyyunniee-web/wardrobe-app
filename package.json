{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "ai:test": "node --experimental-strip-types scripts/ai-evaluation/run-ai-test.ts",
    "ai:report": "node --experimental-strip-types scripts/ai-evaluation/generate-report.ts",
    "ai:wardrobe-entry": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-eval.ts",
    "ai:wardrobe-entry:dry": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-eval.ts --dry-run",
    "ai:wardrobe-entry:baseline": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-eval.ts --version=baseline",
    "ai:wardrobe-entry:current": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-eval.ts --version=current",
    "ai:wardrobe-entry:compare": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-eval.ts --version=both",
    "ai:wardrobe-entry:ocr-isolation": "node --experimental-strip-types scripts/ai-evaluation/run-wardrobe-entry-ocr-isolation.ts",
    "ai:category-ab": "node --experimental-strip-types scripts/ai-evaluation/run-category-ab.ts",
    "ai:category-product-focus": "node --experimental-strip-types scripts/ai-evaluation/run-category-ab.ts --product-focus",
    "ai:beta2-final": "node --experimental-strip-types scripts/ai-evaluation/run-beta2-final-regression.ts",
    "ai:beta21-isolation": "node --experimental-strip-types scripts/ai-evaluation/run-beta21-merge-isolation.ts",
    "ai:beta22-color": "node --experimental-strip-types scripts/ai-evaluation/run-beta22-color-isolation.ts",
    "ai:beta22-smoke": "node --experimental-strip-types scripts/ai-evaluation/run-beta22-local-smoke.ts",
    "ai:beta22-perf": "node --experimental-strip-types scripts/ai-evaluation/run-beta22-performance-smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
